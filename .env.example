# Copy this file to `.env` and fill in your values.
# Maple reads this file on the API server (server/db.ts).

# PostgreSQL connection string (Neon / Supabase / any Postgres).
# For Neon, use the "pooled" or direct URL and keep ?sslmode=require:
#   postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/margin?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/margin?sslmode=require

# Port the API server listens on (the Vite proxy points here).
PORT=4000

# Optional: restrict browser CORS to one origin, e.g. your GitHub Pages URL:
#   CORS_ORIGIN=https://username.github.io/margin
# Leave unset to allow any origin.
CORS_ORIGIN=

# When deploying the frontend to GitHub Pages, set these as repository
# "Variables" in the workflow, not in .env:
#   VITE_API_BASE   the deployed API base URL, e.g. https://margin-api.onrender.com
#   VITE_BASE_PATH  auto-set by the workflow from the repo name
