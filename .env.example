# Copy this file to `.env` and fill in your values.
# Maple reads this file on the API server (server/db/index.ts).

# PostgreSQL connection string (Neon / Supabase / any Postgres).
# For Neon, use the "pooled" or direct URL and keep ?sslmode=require:
#   postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/margin?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/margin?sslmode=require

# Port the API server listens on (the Vite dev proxy points here).
PORT=4000

# Optional: restrict browser CORS to one origin, e.g. http://localhost:5173.
# Leave unset to allow any origin.
CORS_ORIGIN=
